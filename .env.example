# Copy to .env.local and fill in from your Supabase project settings (API section).
# Only these two values may ever appear in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. The station's live audio stream (Icecast/Shoutcast/HLS URL).
# Leave empty until streaming exists: the player then shows real on-air state
# but stays idle instead of pretending to play something.
VITE_STREAM_URL=

# Optional. URL of the Mixota Audio Editor. Defaults to http://localhost:5055 in development or https://mixota.growiota.in in production.
VITE_MIXOTA_URL=http://localhost:5055

# NEVER put SUPABASE_SERVICE_ROLE_KEY here or anywhere under src/.
# The service-role key bypasses Row Level Security and must stay server-side only.

