# Copy to .env.local and fill in from your Supabase project settings (API section).
# Only these two values may ever appear in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. The station's live audio stream (Icecast/Shoutcast/HLS URL).
# Leave empty until streaming exists: the player then shows real on-air state
# but stays idle instead of pretending to play something.
VITE_STREAM_URL=

# ---------------------------------------------------------------------------
# Server-side only. Read by the /api/youtube-live serverless function at
# request time, never by the browser.
#
# The missing VITE_ prefix is the safeguard, not an oversight: Vite inlines
# only VITE_* variables, so a name without it cannot reach the client bundle.
# Set these in the host's environment settings (Vercel -> Settings ->
# Environment Variables), the same place as the values above.
#
# Get a key from the Google Cloud console: create a project, enable "YouTube
# Data API v3", then create an API key. Restrict it to that one API.
# Leave it empty and the Live page simply reports the station as offline.
YOUTUBE_API_KEY=

# Optional. Defaults to the station channel (@vitradiolive) when unset.
YOUTUBE_CHANNEL_ID=

# NEVER put SUPABASE_SERVICE_ROLE_KEY here or anywhere under src/.
# The service-role key bypasses Row Level Security and must stay server-side only.
